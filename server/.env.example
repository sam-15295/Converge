# Copy this file to `.env` and adjust. Never commit `.env`.

NODE_ENV=development
PORT=5000

# Local MongoDB. For production use a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/converge

# Origin of the React app (used for CORS and the CSRF origin check)
CLIENT_URL=http://localhost:5173

# Long random string used to sign login tokens (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NEVER reuse the dev value in production.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# How long a login stays valid (also the cookie lifetime)
JWT_EXPIRES_IN_DAYS=7
# bcrypt cost factor: higher = slower/safer. 12 is a good default.
BCRYPT_ROUNDS=12
# Failed login/signup attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10
# Chat messages one person may send per 10 seconds (document comments get the same number, counted separately)
CHAT_RATE_LIMIT_MAX=30
# Notification requests (list, count, mark as read) one person may make per minute
NOTIFICATION_RATE_LIMIT_MAX=120

# Version history: a document must be quiet this long before its editing session counts as finished
VERSION_QUIET_SECONDS=120
# ...and two versions of the same document are never written closer together than this
VERSION_MIN_GAP_SECONDS=300
